{
	"name": "@djoz-portfolio/client",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"lint": "eslint .",
		"dev": "concurrently --kill-others-on-fail --kill-others -n '🔷 API,🟢 CLIENT' -c 'blue.bold,green.bold' 'pnpm run dev:api' 'pnpm run dev:client'",
		"dev:api": "cd ../dev-api && pnpm start",
		"dev:client": "astro dev --host",
		"dev:setup": "pnpm install && cd ../dev-api && pnpm install",
		"build": "astro build && node ./scripts/postbuild.js",
		"preview": "astro preview --host",
		"astro": "astro"
	},
	"dependencies": {
		"@djoz-portfolio/shared": "workspace:*",
		"@lucide/astro": "^0.545.0",
		"@tailwindcss/vite": "^4.1.14",
		"astro": "^5.14.1",
		"simple-icons": "^15.16.1",
		"tailwindcss": "^4.1.14"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@typescript-eslint/parser": "^8.46.0",
		"cheerio": "^1.1.2",
		"concurrently": "^9.2.1",
		"esbuild": "^0.25.10",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.3.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-no-relative-import-paths": "^1.6.1",
		"eslint-plugin-prettier": "^5.5.4",
		"globals": "^16.4.0",
		"html-minifier-terser": "^7.2.0",
		"prettier": "3.6.2",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"typescript-eslint": "^8.46.0"
	}
}
