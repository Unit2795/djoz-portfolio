{
	"name": "@djoz-portfolio/client",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"lint": "eslint .",
		"dev": "concurrently --kill-others-on-fail --kill-others -n '🔷 API,🟢 CLIENT' -c 'blue.bold,green.bold' 'pnpm run dev:api' 'pnpm run dev:client'",
		"dev:api": "cd ../dev-api && pnpm start",
		"dev:client": "astro dev --host",
		"dev:setup": "pnpm install",
		"typecheck": "astro check",
		"build": "astro check && astro build && node ./scripts/postbuild.js",
		"preview": "astro preview --host",
		"astro": "astro"
	},
	"dependencies": {
		"@djoz-portfolio/shared": "workspace:*",
		"@lucide/astro": "^1.48.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.5",
		"simple-icons": "^16.32.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/parser": "^8.70.1",
		"cheerio": "^1.2.0",
		"concurrently": "^10.0.5",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"eslint-plugin-no-relative-import-paths": "^1.7.3",
		"eslint-plugin-prettier": "^5.5.6",
		"globals": "^17.12.0",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "1.1.0",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	}
}
