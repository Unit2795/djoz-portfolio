---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;

const { role = "tooltip", class: className, ...rest } = Astro.props;
---

<div class="group relative inline-block">
	<slot name="trigger" />

	<div
		role={role}
		class:list={[
			/* Default display */
			"pointer-events-none invisible opacity-0 duration-300 motion-safe:transition-opacity",
			/* Hover Display */
			"group-hover:pointer-events-auto group-hover:visible group-hover:opacity-100",
			/* Interactivity */
			"group-has-[:focus-visible]:pointer-events-auto group-has-[:focus-visible]:visible group-has-[:focus-visible]:opacity-100",
			/* Positioning */
			"absolute left-1/2 z-10 block w-max -translate-x-1/2",
			/* Visual style of the tooltip */
			"rounded-lg bg-gray-600 p-2 shadow-lg",
			className,
		]}
		{...rest}
	>
		<!-- Arrow pointer connecting the popover to the button -->
		<div class="absolute -top-2 left-1/2 h-4 w-4 -translate-x-1/2 rotate-45 bg-gray-600"></div>

		<div>
			<slot name="content" />
		</div>
	</div>
</div>
