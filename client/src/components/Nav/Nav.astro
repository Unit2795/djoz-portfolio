---
import { navbar, disableDynamicNavbar, sections } from "@/content";
import { ChevronDown, Menu, X } from "@lucide/astro";
import { getAnalyticsAttribute } from "@/utils/analyticsAttribute";
import { elementProps } from "@/utils/elementProps";

// Values the <script> reads as this.props
export type ElementProps = {
	disableDynamicNavbar: boolean;
};

const { disableAnalytics } = navbar;
const navSections = Object.values(sections).filter((item) => !item.disabled);
---

<djoz-nav {...elementProps<ElementProps>({ disableDynamicNavbar })}>
	{/* Spacer to help the navbar stand off of the top of the page a little bit for the sticky effect */}
	<div class="pt-10 noscript:pt-0"></div>
	<a
		href="#maincontent"
		class="sr-only top-0 left-0 z-50 text-center text-blue-400 underline focus:not-sr-only focus:absolute! focus:w-full! focus:bg-gray-800/90 focus:p-4! focus:hover:bg-gray-700/90 focus:hover:text-blue-300"
		{...getAnalyticsAttribute("interact", "SkipLink", disableAnalytics)}
	>
		{navbar.skipLinkText ?? "Skip to main content"}
	</a>
	<nav
		aria-label={navbar.ariaLabel ?? "Main navigation"}
		data-navroot
		role="navigation"
		class:list={[
			"sticky -top-px z-40 w-full",
			// Disable dynamic navbar animation if javascript is disabled, user prefers reduced motion, or if the feature is disabled in content config
			"noscript:fixed noscript:top-0!",
			"motion-reduce:fixed motion-reduce:top-0!",
			disableDynamicNavbar && "fixed! top-0!",
		]}
	>
		<div
			data-navcontainer
			class:list={[
				"absolute left-1/2 mx-auto w-4/5 max-w-3xl -translate-x-1/2 rounded-lg bg-gray-900/80 drop-shadow-2xl backdrop-blur-md backdrop-saturate-150 transition-all duration-500 ease-in-out",
				// Disable dynamic navbar animation if javascript is disabled, user prefers reduced motion, or if the feature is disabled in content config
				"noscript:w-full noscript:max-w-none noscript:rounded-none",
				"motion-reduce:w-full motion-reduce:max-w-none motion-reduce:rounded-none",
				disableDynamicNavbar && "w-full! max-w-none! rounded-none!",
			]}
		>
			{/*Navbar content, scaled to container width (keeps content away from edges on larger screens)*/}
			<div class="relative container mx-auto">
				<div class="mx-auto flex h-16 items-center justify-between p-4 pr-2">
					{navbar.header && <h1
						class:list={[
							"from-primary to-secondary navbar-header-link inline-block bg-linear-to-r bg-clip-text font-bold text-transparent transition-transform duration-300 motion-safe:hover:scale-105",
							navbar.header.size ?? "text-2xl",
						]}
						{...getAnalyticsAttribute("interact", "NavHeader", disableAnalytics)}
					>
						<a href={navbar.header.href ?? "#top"}>{navbar.header.text}</a>
					</h1>}
					{/* Desktop Menu */}
					<ul class="hidden md:flex">
						{navSections.map(({ id, navTitle, analyticsLabel }) => <li class="h-16">
							<a
								class="navbar-link select-none flex h-full items-center justify-center px-3 text-gray-200 hover:text-blue-400 motion-safe:transition-colors motion-safe:duration-300"
								href={`#${id}`}
								{...getAnalyticsAttribute(
									"interact",
									`NavLink-${analyticsLabel ?? id}`,
									disableAnalytics,
								)}
							>
								{navTitle}
							</a>
						</li>)}
						{navbar.moreLinks && navbar.moreLinks.items && navbar.moreLinks.items.length > 0 && <li
							class="group relative flex h-16 items-center justify-center px-3"
						>
							<button
								aria-haspopup="true"
								class="flex items-center justify-center gap-1"
								{...getAnalyticsAttribute("interact", `NavMoreLinks`, disableAnalytics)}
							>
								<span>{navbar.moreLinks.label}</span>
								<ChevronDown
									size={20}
									aria-hidden="true"
									class="transition-transform duration-200 group-focus-within:rotate-180 group-hover:rotate-180 motion-reduce:transition-none"
								/>
							</button>
							<ul
								class="absolute top-full right-0 hidden min-w-48 list-none rounded-md border border-gray-700 bg-gray-900 bg-linear-to-b from-gray-800 to-gray-900 p-2 drop-shadow-md/50 group-focus-within:block group-hover:block"
							>
								{navbar.moreLinks.items?.map(({ label, href, newTab, analyticsLabel }) => <li
									class="border-t border-gray-700 first:mt-0 first:border-t-0"
								>
									<a
										class="select-none block px-3 py-2 text-gray-200 transition-all duration-300 hover:bg-white/5 hover:text-blue-400 motion-safe:transition-colors motion-safe:duration-300"
										href={href}
										target={newTab ? "_blank" : "_self"}
										{...getAnalyticsAttribute(
											"interact",
											`NavMoreLink-${analyticsLabel}`,
											disableAnalytics || !analyticsLabel,
										)}
									>
										{label}
									</a>
								</li>)}
							</ul>
						</li>}
					</ul>
				</div>

				{/* Mobile: native disclosure */}
				<details class="nav-disclosure group select-none md:hidden" data-mobile-menu>
					<summary
						class="fixed top-1 right-1 flex h-14 w-14 cursor-pointer list-none items-center justify-center rounded-lg border border-gray-700 bg-slate-900/50 shadow-lg shadow-black/30 select-none hover:bg-slate-800/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
						aria-label={navbar.hamburgerMenuAriaLabel ?? "Toggle navigation menu"}
						{...getAnalyticsAttribute("interact", `NavOpenMobileMenu`, disableAnalytics)}
					>
						<Menu aria-hidden="true" class="mx-auto h-6 w-6 text-gray-400 group-open:hidden" />
						<X aria-hidden="true" class="mx-auto hidden h-6 w-6 text-gray-400 group-open:block" />
					</summary>

					<div class="bg-linear-to-b from-transparent to-gray-800/80 md:hidden">
						{/* Mobile Menu Items */}
						<ul
							class="divide-y divide-white/5 p-2 px-4 pt-1 pb-2 text-right"
							aria-label={navbar.mobileMenuAriaLabel ?? "Mobile navigation menu"}
						>
							{navSections.map(({ id, navTitle, analyticsLabel }) => <li>
								<a
									href={`#${id}`}
									class="navbar-mobile-link select-none block rounded-lg px-4 py-3 text-gray-300 transition-all duration-300 hover:bg-white/5 hover:text-blue-400"
									{...getAnalyticsAttribute(
										"interact",
										`NavMobileLink-${analyticsLabel ?? id}`,
										disableAnalytics,
									)}
								>
									{navTitle}
								</a>
							</li>)}
							{navbar.moreLinks && navbar.moreLinks.items && navbar.moreLinks.items.length > 0 && <li>
								<details class="group/section rounded-lg pb-2">
									<summary
										class="flex cursor-pointer items-center justify-end gap-1 rounded-lg px-4 py-3 text-gray-300 transition-all duration-300 hover:bg-white/5 hover:text-blue-400"
										{...getAnalyticsAttribute("interact", `NavMobileMoreLinks`, disableAnalytics)}
									>
										<span class="font-semibold">{navbar.moreLinks.label}</span>
										<ChevronDown
											size={20}
											aria-hidden="true"
											class="transition-transform duration-200 group-open/section:rotate-180 motion-reduce:transition-none"
										/>
									</summary>
									<ul
										class="mx-3 mt-1 space-y-1 divide-y divide-white/10 rounded-lg border border-white/10 bg-gray-700/20"
									>
										{navbar.moreLinks.items?.map(({ label, href, newTab, analyticsLabel }) => <li>
											<a
												href={href}
												class="select-none block px-4 py-3 text-gray-300 transition-all duration-300 hover:bg-white/5 hover:text-blue-400"
												target={newTab ? "_blank" : "_self"}
												{...getAnalyticsAttribute(
													"interact",
													`NavMoreLinkMobile-${analyticsLabel}`,
													disableAnalytics || !analyticsLabel,
												)}
											>
												{label}
											</a>
										</li>)}
									</ul>
								</details>
							</li>}
						</ul>
					</div>
				</details>
			</div>
		</div>
	</nav>
</djoz-nav>

<script>
	import { initMobileMenu } from "@/components/Nav/utils/initMobileMenu";
	import { initNavbarAnimation } from "@/components/Nav/utils/initNavbarAnimation";
	import { initScrollSpy } from "@/components/Nav/utils/initScrollSpy";
	import type { ElementProps } from "@/components/Nav/Nav.astro";
	import { PropsElement } from "@/utils/PropsElement";

	/**
	 * Initializes all navbar features:
	 * - Mobile menu functionality (hamburger menu, click outside to close)
	 * - Scroll-based resize animation (with reduced motion support)
	 * - Active section highlighting based on scroll position
	 */
	class DjozNav extends PropsElement<ElementProps> {
		root = this.querySelector<HTMLElementTagNameMap["nav"]>("[data-navroot]");
		navContainer = this.querySelector<HTMLDivElement>("[data-navcontainer]");
		mobileMenu = this.querySelector<HTMLDetailsElement>("[data-mobile-menu]");

		connectedCallback() {
			const { root, mobileMenu, navContainer } = this;

			if (!root || !mobileMenu || !navContainer) {
				console.error("Navbar elements not found");
				return;
			}

			initMobileMenu(root, mobileMenu);
			initNavbarAnimation(navContainer, this.props.disableDynamicNavbar);
			// Use a top offset to account for the fixed navbar height when determining active sections
			initScrollSpy(root, 80);
		}
	}

	customElements.define("djoz-nav", DjozNav);
</script>

<style>
	html {
		scroll-padding-top: 64px;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	/* Animation for mobile menu in browsers that support it */
	@supports selector(::details-content) {
		.nav-disclosure::details-content {
			max-height: 0;
			opacity: 0;
			overflow: clip;
			transition:
				max-height 300ms ease,
				opacity 500ms ease,
				content-visibility 300ms allow-discrete;
		}
		.nav-disclosure[open]::details-content {
			max-height: 500px;
			opacity: 1;
		}
	}
</style>
