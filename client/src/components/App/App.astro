---
import AvailabilityBadge from "@/components/AvailabilityBadge/AvailabilityBadge.astro";
import Hero from "@/components/Hero/Hero.astro";
import Nav from "@/components/Nav/Nav.astro";
import Skills from "@/components/sections/Skills/Skills.astro";
import Projects from "@/components/sections/Projects/Projects.astro";
import AriaAnnouncer from "@/components/AriaAnnouncer/AriaAnnouncer.astro";
import Intro from "@/components/sections/Intro/Intro.astro";
import ContactForm from "@/components/sections/ContactForm/ContactForm.astro";
import Footer from "@/components/Footer/Footer.astro";
import { disableAnalytics, disableDwellCookie, disableNavbar, sections } from "@/content";
import Analytics from "@/components/Analytics/Analytics.astro";
import DwellBeacon from "@/components/DwellBeacon/DwellBeacon.astro";
---

<AriaAnnouncer />
{!disableAnalytics && <Analytics />}
{!disableDwellCookie && !sections.CONTACT.disabled && <DwellBeacon />}
{!disableNavbar && <Nav />}
<main class:list={["relative z-10"]} id="maincontent">
	{!sections.INTRO.disabled && <Intro />}
	{!sections.PROJECTS.disabled && <Projects />}
	{!sections.SKILLS.disabled && <Skills />}
	{!sections.CONTACT.disabled && <ContactForm />}
</main>
<Footer />
<AvailabilityBadge />
<Hero />

<script>
	// Dev only: a custom element whose tag isn't defined stays inert without any error, so report it
	if (import.meta.env.DEV) {
		document.addEventListener("DOMContentLoaded", () => {
			const tags = new Set(Array.from(document.querySelectorAll(":not(:defined)"), (el) => el.localName));
			if (tags.size > 0) {
				console.error(
					`<${[...tags].join(">, <")}> never got defined. Check its customElements.define() call and tag name.`,
				);
			}
		});
	}
</script>
