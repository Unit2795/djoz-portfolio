---
/**
 * This component applies staggered animations to its grid of child elements marked with the `animated-grid-item` class as they enter the viewport (uses Intersection Observer API).
 */

import { props } from "@/utils/customEl/server";

interface Props {
	// The delay in milliseconds between the animations of each item.
	animationInterval?: number;
	// Name of the CSS classes to apply to each item for animation styling.
	class?: string[];
}

export type Expose = Props;
---

<animated-grid {...props<Expose>(Astro.props)}>
	<slot />
</animated-grid>
<script>
	import type { Expose } from "@/components/AnimatedGrid/AnimatedGrid.astro";
	import { CustomEl, customEl } from "@/utils/customEl/client";
	import { throttle } from "@/utils/throttle";

	customEl(
		"animated-grid",
		class extends CustomEl<Expose> {
			items = Array.from(this.querySelectorAll(".animated-grid-item"));
			animationInterval = this.props.animationInterval;
			class = this.props.class;

			connectedCallback() {
				const batch: HTMLElement[] = [];
				/* 
					We process items in batches so that we can aggregate multiple items that enter the viewport simultaneously (within a small time period).
					We sort them by their position in the grid (top to bottom, left to right) before applying the animation delay and classes. This ensures the stagger animation follows the visual order of the grid. It's not guaranteed that items will arrive in the intersection observer in the same order they appear in the DOM or visually. This even accounts for elements that use the css "order" property to change their visual position while keeping the DOM order the same.
				*/
				const processBatch = () => {
					if (batch.length) {
						batch.sort((a, b) => {
							// First sort elements by rows
							if (a.offsetTop !== b.offsetTop) return a.offsetTop - b.offsetTop;
							// Then sort by columns
							return a.offsetLeft - b.offsetLeft;
						});

						// Apply the animations and classes
						batch.forEach((card, index) => {
							if (this.animationInterval) {
								card.style.animationDelay = `${index * this.animationInterval}ms`;
							}
							if (this.class) {
								card.classList.add(...this.class);
							}
						});

						// Clear the batch after processing
						batch.length = 0;
					}
				};

				// Create a throttled version of the batch processing function to limit how often it runs and ensure we aggregate multiple items entering the viewport together.
				const throttledProcessBatch = throttle(processBatch, 200);
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							// If the item is intersecting, add it to the batch and unobserve it
							if (entry.isIntersecting && entry.target instanceof HTMLElement) {
								observer.unobserve(entry.target);
								batch.push(entry.target);
							}
						});
						throttledProcessBatch();
					},
					{ threshold: 0.1 },
				);
				// Observe each item in the grid
				this.items.forEach((item) => observer.observe(item));
			}
		},
	);
</script>
<style is:global>
	.animated-grid-item {
		opacity: 0;
	}

	@media (scripting: none) {
		.animated-grid-item {
			opacity: 1;
		}
	}
</style>
