---
import CopyValue from "@/components/CopyValue/CopyValue.astro";
import Icon, { type IconType } from "@/components/Icon/Icon.astro";
import { copyValue } from "@/content";
import { CircleCheckBig } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
	value: string;
	icon: IconType;
};

const { value, icon, ...rest } = Astro.props;
const tooltipId = getId();

/* 
	This is a helper component to simplify the usage of the CopyValue component with an icon trigger.
	It wraps the CopyValue component and sets up the necessary slots for trigger, content, and success message.

	It also includes No-JS support by displaying a read-only input field with the value to be copied.
*/
---

<CopyValue value={value} {...rest}>
	<span slot="trigger">
		<Icon class="h-6 w-6 text-white" aria-hidden {...icon} />
	</span>
	<span slot="content">
		<p class="text-center">
			<span class="mb-1 block text-sm text-nowrap text-gray-300">
				{copyValue.text ?? "Click to copy:"}
			</span>

			<span class="block">{value}</span>
		</p>
	</span>
	<span slot="success">
		<div class="flex items-center text-nowrap">
			<CircleCheckBig class="mr-2 text-green-500" aria-hidden="true" />

			<p>{copyValue.successText ?? "Copied successfully!"}</p>
		</div>
	</span>
</CopyValue>
