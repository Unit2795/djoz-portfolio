---
import type { SnowEffectConfig } from "@/components/SnowParticles/utils/snowEffect";
import { elementProps } from "@/utils/elementProps";

interface Props {
	config: SnowEffectConfig;
}

// Values the <script> reads as this.props
export type ElementProps = {
	config: SnowEffectConfig;
};

const { config } = Astro.props;
---

<snow-particles
	class="pointer-events-none absolute inset-0 overflow-hidden motion-reduce:hidden"
	{...elementProps<ElementProps>({ config })}
>
	<canvas class="absolute top-0 left-0 h-full w-full bg-transparent"></canvas>
</snow-particles>

<script>
	import type { ElementProps } from "@/components/SnowParticles/SnowParticles.astro";
	import { SnowEffect } from "@/components/SnowParticles/utils/snowEffect";
	import { PropsElement } from "@/utils/PropsElement";

	class SnowParticles extends PropsElement<ElementProps> {
		canvas = this.querySelector<HTMLCanvasElement>("canvas");

		connectedCallback() {
			// Initialize navbar features when DOM is ready
			// Respect user preference for reduced motion, disabling animation if needed
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				console.log("Reduced motion preference detected, will not render snow effect particles");
				return;
			}

			const { canvas } = this;

			if (!canvas) {
				console.error("Canvas element not found");
				return;
			}

			// Ensure canvas 2D context is available
			const context = canvas.getContext("2d");
			if (!context) {
				console.error("Failed to get canvas context, will not render snow effect particles");
				return;
			}

			new SnowEffect(canvas, context, this.props.config);
		}
	}

	customElements.define("snow-particles", SnowParticles);
</script>
