---
import App from "@/components/App/App.astro";
import "@/styles/index.css";
import { description, intro, jobTitle, name, shareImage, title } from "@/content";

const siteUrl = new URL("/", Astro.site).href;

// Person structured data for search engines, see https://schema.org/Person
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name,
	url: siteUrl,
	jobTitle,
	sameAs: intro.links?.flatMap(({ link }) => (link ? [link] : [])),
};
---

<html lang="en">
	<head>
		<!-- Standard favicons -->
		<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
		<!-- Android Chrome -->
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-chrome-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon/android-chrome-512x512.png" />
		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
		<!-- Web Manifest -->
		<link rel="manifest" href="/site.webmanifest" />

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="author" content={name} />
		<link rel="canonical" href={siteUrl} />

		<!-- Social share previews (Open Graph / Twitter) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{shareImage && (
			<>
				<meta property="og:image" content={new URL(shareImage.path, Astro.site).href} />
				<meta property="og:image:width" content={String(shareImage.width)} />
				<meta property="og:image:height" content={String(shareImage.height)} />
				<meta property="og:image:alt" content={shareImage.alt} />
			</>
		)}
		<meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<title>{title}</title>
	</head>
	<body class="relative w-full bg-gray-900 text-white">
		<App />
	</body>
</html>
